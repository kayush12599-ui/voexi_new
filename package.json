{
  "name": "voexi_new",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "eas-build-pre-install": "npm config set legacy-peer-deps true",
    "start": "npx expo start",
    "scan": "npx expo start",
    "postinstall": "node scripts/generate_missing_assets.js && node scripts/patch-metro.js",
    "tunnel": "npx expo start --tunnel",
    "go": "npx expo start --clear",
    "fix": "Remove-Item -Path .expo, metro-cache-local, metro-cache-new -Recurse -Force -ErrorAction SilentlyContinue && npx expo start --clear",
    "clean": "taskkill /f /im node.exe & rd /s /q .expo & rd /s /q node_modules & npm install & npx expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node scripts/patch-metro.js && npx expo start --web -c",
    "web:export": "npx expo export -p web -c && node scripts/prepare_deploy.js",
    "web:serve": "npx serve dist -s"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
